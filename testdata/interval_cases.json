          "climateWh": 12.0,
          "integratedSeconds": 60.0,
          "speedDistanceKm": 0.8,
          "odometerDistanceKm": 0.8,
          "speedIntegratedSeconds": 60.0,
          "climateIntegratedSeconds": 60.0
        },
        {
          "sessionId": "trip-steady",
          "startUtcMillis": 1710000060000,
          "tractionWh": 260.0,
          "regeneratedWh": 0.0,
          "auxiliaryWh": 20.0,
