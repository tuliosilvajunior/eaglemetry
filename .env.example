# Where the account server is. Copy this file to `.env` and fill it in.
#
# `.env` is not committed. Build with:
#
#   flutter run   --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Both values come from the Supabase panel, under Project Settings > API.
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_ANON_KEY name the same publishable
# key (Supabase renamed it); either is accepted, publishable is preferred
# for Flutter. Leave them empty and the app runs with no account at all:
# pairing, sync and history are unchanged. They never needed a server.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Native Android BuildConfig keys have their own template at android/local.properties.example.
