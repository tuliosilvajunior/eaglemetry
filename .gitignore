# Telemetry databases pulled off the car. These carry real trip history,
# including the latitude/longitude columns of telemetry_frames, and must never
# reach the repository.
dbpull/
*.db
*.db-wal
*.db-shm

# Raw telemetry pulled out of a vehicle or the cloud. Same class as *.db:
# evidence to read, not source to version.
dbpull/

# Claude Code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Vehicle line-art sources. They are ~5 MB each and carry the transparency
# checkerboard as real pixels. Keep them local; commit only the WebP that
# scripts/extract_line_art.py produces into assets/images/.
imgs/

# Supabase CLI local link state (project ref, versions). Not source.
supabase/.temp/

# Release manifest & artifacts
dist/

# Roadcast binaries are NOT distributed with this repository (see README).
# Built locally from https://github.com/Timoteohss/roadcast; never commit them.
android/app/src/main/assets/roadcastd
android/app/src/main/jniLibs/arm64-v8a/libroadcast_client.so
.pgurl.local
.pgurl.pooler

# Kotlin compiler session artifacts
android/.kotlin/

# Account server credentials. `.env.example` is the committed template; `.env`
# is not committed. Copy `.env.example` to `.env` and fill it in. See also
# `apps/companion/.env.example` for the companion app's copy.
.env

# Local treehouse worktree pool (machine-local disposable checkouts).
.treehouse/
