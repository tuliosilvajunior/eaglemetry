# Where the account server is. Copy this file to `.env` and fill it in.
#
# `.env` is not committed. Build with:
#
#   flutter run   --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Both values come from the Supabase panel, under Project Settings > API.
# Leave them empty and the app runs with no account at all: the journey skips
# the login step, and pairing, sync and history are unchanged. They never
# needed a server.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Cloud-sync gate for Lanes A/B/C: real cloud sync is wired and defaults ON
# (the dart-define defaults to true). No line is needed for a normal build;
# set it to false only to turn the gate off for a build that needs it.
# The car side uses the same gate via BuildConfig.CLOUD_SYNC_ENABLED
# (local.properties / gradle property / env).
#   flutter run --dart-define-from-file=.env
# CLOUD_SYNC_ENABLED=true
